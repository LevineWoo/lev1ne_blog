---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconRss from "@/assets/icons/IconRss.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import Card from "@/components/Card.astro";
import LinkButton from "@/components/LinkButton.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { getUniqueTags } from "@/utils/getUniqueTags";
import { slugifyStr } from "@/utils/slugify";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { site, socials, posts: postsConfig } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const posts = await getCollection("posts");
const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);
const homePath = getRelativeLocaleUrl(locale, "");

// 主題格：[emoji, 顯示名, 對應標籤]。
// 對應標籤有文章先會變成連結，冇就只係普通文字（唔會連去 404）。
const topics = [
  ["🧑‍💻", "Tech & Coding", "Linux"],
  ["🌐", "Network & Cloud", "Network"],
  ["🤖", "AI & Tools", "AI"],
  ["🏠", "Self-hosted", "Docker"],
  ["💳", "FinTech & Payment", "Payment"],
  ["🛰️", "Internet & Digital Life", "Internet"],
  ["💼", "Work & Life", "Work"],
  ["✍️", "隨筆", "隨筆"],
];

const existingTags = new Set(getUniqueTags(posts).map(({ tag }) => tag));
const topicLinks = topics.map(([icon, label, tagName]) => {
  const tag = slugifyStr(tagName);
  return {
    icon,
    label,
    href: existingTags.has(tag)
      ? getRelativeLocaleUrl(locale, `tags/${tag}/`)
      : null,
  };
});

// 「宜家玩緊」：近況，一兩句就夠，得閒改呢度。
const nowItems = [
  "啱啱將幾篇 VPS 筆記重寫咗一次，Docker、Swap、NGINX ACME 都更新過。",
  "試緊唔同 AI 工具同訂閱付款方法，有心得就寫。",
];
---

<Layout>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout"
  >
    <section id="hero" class="border-border border-b py-12 sm:py-16">
      <div class="grid gap-8 lg:grid-cols-3 lg:items-start lg:gap-10">
        <div class="lg:col-span-2">
          <div
            class="border-border bg-muted/40 inline-flex items-center rounded-full border px-3 py-1 text-sm font-medium"
          >
            🐠 Personal Blog
          </div>

          <h1
            class="mt-5 text-4xl font-bold tracking-tight sm:text-5xl lg:text-6xl"
          >
            {site.author}
          </h1>

          <p class="text-muted-foreground mt-3 text-lg font-medium sm:text-xl">
            Tech · Internet · AI · Digital Life · Notes
          </p>

          <div class="mt-7 max-w-2xl space-y-4 text-lg leading-8">
            <p class="font-medium">
              一個鍾意搞 Tech、玩 Network、研究 AI，同埋乜都想試吓嘅廣東人。👨‍💻
            </p>

            <p>
              平時記低踩過嘅坑、試過嘅設定、用過嘅服務；有時亦會寫下
              Internet、Payment、返工同生活入面一啲值得記低嘅嘢。
            </p>

            <p class="text-muted-foreground">
              呢度唔係淨係 VPS 筆記——由 Server 到 AI，由工具到生活，啱傾就寫。🛠️
            </p>
          </div>

          <div class="mt-7 flex flex-wrap gap-3">
            <a
              href={getRelativeLocaleUrl(locale, "posts")}
              class="bg-accent text-accent-foreground inline-flex items-center gap-2 rounded-xl px-4 py-2.5 font-medium shadow-sm transition-transform hover:-translate-y-0.5 hover:opacity-90"
            >
              <span>📚 睇文章</span>
              <IconArrowRight class="inline-block size-5 rtl:-rotate-180" />
            </a>

            <a
              href={getRelativeLocaleUrl(locale, "about")}
              class="border-border bg-muted/30 hover:border-accent hover:text-accent inline-flex items-center rounded-xl border px-4 py-2.5 font-medium transition-colors"
            >
              👋 關於我
            </a>
          </div>

          <div class="mt-8">
            <p
              class="text-muted-foreground mb-3 text-xs font-semibold tracking-widest uppercase"
            >
              🧩 平時寫啲乜
            </p>

            <div class="grid grid-cols-2 gap-2 sm:grid-cols-4">
              {
                topicLinks.map(({ icon, label, href }) =>
                  href ? (
                    <a
                      href={href}
                      class="border-border bg-muted/30 hover:border-accent hover:text-accent flex min-h-11 items-center gap-2 rounded-xl border px-3 py-2 text-sm transition-colors"
                    >
                      <span aria-hidden="true">{icon}</span>
                      <span class="leading-tight font-medium">{label}</span>
                    </a>
                  ) : (
                    <div class="border-border text-muted-foreground flex min-h-11 items-center gap-2 rounded-xl border border-dashed px-3 py-2 text-sm">
                      <span aria-hidden="true">{icon}</span>
                      <span class="leading-tight font-medium">{label}</span>
                    </div>
                  )
                )
              }
            </div>
          </div>
        </div>

        <aside
          class="border-border bg-muted/20 rounded-2xl border p-5 shadow-sm sm:p-6"
        >
          <div>
            <p
              class="text-muted-foreground text-xs font-semibold tracking-widest uppercase"
            >
              Right now
            </p>
            <h2 class="mt-1 text-xl font-semibold">🧪 宜家玩緊</h2>
          </div>

          <ul class="mt-4 space-y-3 leading-relaxed">
            {nowItems.map(item => <li>{item}</li>)}
          </ul>

          <div class="border-border mt-5 border-t pt-5">
            <p class="text-muted-foreground mb-2 text-sm font-medium">
              🔗 搵我
            </p>

            <div class="flex flex-wrap items-center gap-2">
              {socials.length > 0 && <Socials />}

              <a
                target="_blank"
                href={`${import.meta.env.BASE_URL.replace(/\/?$/, "/")}rss.xml`}
                class="border-border hover:border-accent hover:text-accent inline-flex items-center gap-2 rounded-lg border px-2.5 py-1.5 transition-colors"
                aria-label="RSS Feed"
                title="RSS Feed"
              >
                <IconRss
                  width={18}
                  height={18}
                  class="stroke-2.5 stroke-current rtl:-rotate-90"
                />
                <span class="text-sm font-medium">RSS</span>
              </a>
            </div>
          </div>
        </aside>
      </div>
    </section>

    {
      featuredPosts.length > 0 && (
        <section
          id="featured"
          class:list={[
            "pt-12 pb-6",
            { "border-border border-b": recentPosts.length > 0 },
          ]}
        >
          <h2 class="text-2xl font-semibold tracking-wide">
            {t.home.featured}
          </h2>
          <ul>
            {featuredPosts.map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    {
      recentPosts.length > 0 && (
        <section id="recent-posts" class="pt-12 pb-6">
          <h2 class="text-2xl font-semibold tracking-wide">
            {t.home.recentPosts}
          </h2>
          <ul>
            {recentPosts.slice(0, postsConfig.perIndex).map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    <div class="my-8 text-center">
      <LinkButton href={getRelativeLocaleUrl(locale, "posts")}>
        {t.home.allPosts}
        <IconArrowRight class="inline-block rtl:-rotate-180" />
      </LinkButton>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>
